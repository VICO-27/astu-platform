# ─────────────────────────────────────────────────────────────────────────────
#  ASTU Platform — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-replace-with-50-random-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# For production on Render: ALLOWED_HOSTS=your-app.onrender.com

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=astu_db
DB_USER=astu_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# For Render Postgres, set DB_HOST to the internal hostname

# ── JWT / Cookies ─────────────────────────────────────────────────────────────
COOKIE_SECURE=False
# Set COOKIE_SECURE=True in production (requires HTTPS)

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Cloudinary (media storage) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# For Render Redis: redis://red-xxxxx:6379

# ── Groq AI ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=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
GROQ_MODEL=groq/compound
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Set GROQ_AI_MOCK=True for local development when no Groq API key is unavailable
GROQ_AI_MOCK=False

# ── GitHub Integration (optional) ────────────────────────────────────────────
# Personal access token with repo:read scope
GITHUB_TOKEN=ghp_your-github-token-here

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# For production: CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
